<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV 启动横幅 320x180 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 渐变背景 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A1036"
                android:centerColor="#241247"
                android:endColor="#0D0D1A"
                android:angle="45" />
        </shape>
    </item>

    <!-- 左侧图标 -->
    <item
        android:width="92dp"
        android:height="92dp"
        android:gravity="center_vertical|start"
        android:start="20dp"
        android:drawable="@drawable/ic_launcher" />

</layer-list>
