<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮：玻璃质感，聚焦绿色高光描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill_strong" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke android:width="2dp" android:color="@color/accent_green" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#2EFFFFFF" android:endColor="#00FFFFFF" android:angle="270" />
                    <corners android:radius="@dimen/radius_sm" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_dim" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
