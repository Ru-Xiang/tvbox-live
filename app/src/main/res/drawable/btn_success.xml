<?xml version="1.0" encoding="utf-8"?>
<!-- 成功按钮：玻璃质感绿色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FF34D158" android:endColor="#FF0A84FF" android:angle="135" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0E9F6E" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FF30D158" android:endColor="#FF1FB85A" android:angle="135" />
                    <corners android:radius="@dimen/radius_sm" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" android:angle="270" />
                    <corners android:radius="@dimen/radius_sm" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
