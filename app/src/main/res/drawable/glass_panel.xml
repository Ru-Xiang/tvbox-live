<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃面板：半透明填充 + 顶部高光 + 细描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/glass_stroke_width" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <!-- 顶部高光（玻璃反射感） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</layer-list>
