<?xml version="1.0" encoding="utf-8"?>
<!-- 侧边栏玻璃：较强毛玻璃，右侧高光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40121226" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2EFFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="0" />
        </shape>
    </item>
    <!-- 右缘高光 -->
    <item android:width="1dp" android:gravity="end">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
