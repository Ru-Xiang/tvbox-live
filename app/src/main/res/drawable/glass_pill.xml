<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃药丸（信息栏/状态条）：大圆角 + 高光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59121226" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke android:width="@dimen/glass_stroke_width" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2EFFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>
