<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框/Spinner 玻璃背景：聚焦时蓝色描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/radius_xs" />
            <stroke android:width="1.5dp" android:color="@color/accent_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_dim" />
            <corners android:radius="@dimen/radius_xs" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
        </shape>
    </item>
</selector>
