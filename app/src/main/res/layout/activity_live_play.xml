<?xml version="1.0" encoding="utf-8"?>
<!-- 直播播放界面 - 液态玻璃风格，适配安卓电视全屏播放 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- 播放器容器 -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.exoplayer2.ui.StyledPlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />
    </FrameLayout>

    <!-- 加载指示器 -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_blue"
        android:visibility="gone" />

    <!-- 数字输入显示（玻璃药丸） -->
    <TextView
        android:id="@+id/tv_input_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/glass_pill"
        android:fontFamily="sans-serif-medium"
        android:minWidth="96dp"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingTop="14dp"
        android:paddingEnd="32dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:visibility="gone" />

    <!-- 频道信息面板 - 底部玻璃药丸 -->
    <LinearLayout
        android:id="@+id/channel_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/glass_pill"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 台标 -->
            <ImageView
                android:id="@+id/iv_info_logo"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:layout_marginEnd="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@string/channel_info" />

            <!-- 频道分组（玻璃小标签） -->
            <TextView
                android:id="@+id/tv_channel_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_tag"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:textColor="@color/accent_purple_light"
                android:textSize="13sp" />

            <!-- 频道名称 -->
            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- 收藏星标 -->
            <ImageView
                android:id="@+id/iv_info_favorite"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                android:contentDescription="@string/group_favorite" />

            <!-- 源信息 -->
            <TextView
                android:id="@+id/tv_source_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <!-- 速度信息（玻璃药丸） -->
            <TextView
                android:id="@+id/tv_speed_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_speed_tag"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- EPG 节目信息 -->
        <TextView
            android:id="@+id/tv_epg_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 频道列表侧边栏（玻璃） -->
    <LinearLayout
        android:id="@+id/channel_list_panel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/glass_sidebar"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 分组列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_group_list"
            android:layout_width="148dp"
            android:layout_height="match_parent"
            android:background="@color/glass_fill_dim"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp" />

        <!-- 分割线（玻璃高光） -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/glass_stroke_soft" />

        <!-- 频道列表（含操作提示） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_channel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="18dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/glass_fill_dim"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="OK 播放 · 长按 收藏/拉黑 · 返回 关闭"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 当前线路网速 - 右下角常驻玻璃药丸 -->
    <TextView
        android:id="@+id/tv_corner_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/glass_pill"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 测速状态栏 - 右上角玻璃药丸 -->
    <LinearLayout
        android:id="@+id/speed_test_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/speed_test_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="120dp"
            android:layout_height="6dp"
            android:progressTint="@color/accent_green" />

        <TextView
            android:id="@+id/tv_speed_test_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxWidth="260dp"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
