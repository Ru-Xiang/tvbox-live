<?xml version="1.0" encoding="utf-8"?>
<!-- EPG 节目单单项 - 液态玻璃卡片风 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_list_item"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- 左侧：当前节目指示器（点） -->
    <View
        android:id="@+id/v_now_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_epg_now_dot"
        android:visibility="invisible" />

    <!-- 时间列 -->
    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_epg_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.02"
            tools:text="20:00" />

        <TextView
            android:id="@+id/tv_epg_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:text="21:00" />
    </LinearLayout>

    <!-- 中列：节目标题 + 进度条 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_epg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="新闻联播" />

        <!-- 进度条：仅当前节目显示 -->
        <ProgressBar
            android:id="@+id/pb_epg_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:progressTint="@color/accent_green"
            android:progressBackgroundTint="@color/glass_fill_dim"
            android:visibility="gone"
            android:progress="35" />
    </LinearLayout>

    <!-- 右侧：状态标签（正在播 / 时长） -->
    <TextView
        android:id="@+id/tv_epg_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_speed_tag"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="正在播" />

</LinearLayout>
