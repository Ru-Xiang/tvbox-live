<?xml version="1.0" encoding="utf-8"?>
<!-- 频道列表项 - 液态玻璃风格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_list_item"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="13dp">

    <!-- 频道台标 -->
    <ImageView
        android:id="@+id/iv_channel_logo"
        android:layout_width="42dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher"
        android:contentDescription="@string/channel_info" />

    <!-- 频道名 + 源数 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            tools:text="CCTV-1 综合" />

        <TextView
            android:id="@+id/tv_channel_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:text="3 个源" />
    </LinearLayout>

    <!-- 速度标签 -->
    <TextView
        android:id="@+id/tv_channel_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_speed_tag"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="流畅" />

    <!-- 收藏星标 -->
    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_star"
        android:visibility="gone"
        android:contentDescription="@string/group_favorite" />
</LinearLayout>
